# Minimal x86-64 QEMU appliance: a CAN gateway with nftables and SELinux enforcing. This is a
# starting defconfig; the exact option set is validated by actually running `make` (offline).
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.32"
# CAN (vcan, raw) and netfilter/SELinux are enabled via a kernel fragment (board/linux.fragment).
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_VNSL_PATH)/board/linux.fragment"
BR2_PACKAGE_LIBCAP_NG=y
BR2_PACKAGE_LIBSELINUX=y
BR2_PACKAGE_POLICYCOREUTILS=y
BR2_PACKAGE_REFPOLICY=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_CAN_UTILS=y
BR2_PACKAGE_VN_GATEWAY=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_VNSL_PATH)/board/rootfs-overlay"
